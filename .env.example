# ─────────────────────────────────────────────
# speaches — local Whisper transcription (STT)
# ─────────────────────────────────────────────

# Whisper model to load on startup.
# Larger models are more accurate but require more RAM and disk.
#
# Model      | Type           | RAM   | Disk    | CPU latency (30s audio)
# -----------|----------------|-------|---------|------------------------
# tiny.en    | English-only   | ~1 GB | ~150 MB | ~0.5–1s
# base       | Multilingual   | ~1 GB | ~280 MB | ~1–2s
# small      | Multilingual   | ~2 GB | ~970 MB | ~2–3s
# medium     | Multilingual   | ~5 GB | ~3 GB   | ~5–8s
# large-v3   | Multilingual   | ~10GB | ~6 GB   | ~3–5s  ← default (best accuracy)
ASR_MODEL=large-v3

# Port speaches listens on (host-side).
# OpenAI-compatible endpoint: http://<host>:<port>/v1/audio/transcriptions
SPEACHES_PORT=9000

# ─────────────────────────────────────────────
# kokoro — local TTS
# ─────────────────────────────────────────────

# Port kokoro listens on (host-side).
# OpenAI-compatible endpoint: http://<host>:<port>/v1/audio/speech
KOKORO_PORT=8880
